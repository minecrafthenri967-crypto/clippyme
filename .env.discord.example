# ══════════════════════════════════════════════════════════════
#  DISCORD BOT — Gatekeeper für Clip-Genehmigungen
#
#  Kopiere diese Datei zu .env.discord und fülle deine Werte ein.
#  .env.discord wird in .gitignore ignoriert und nicht hochgeladen.
#
#  Trag die Werte direkt hinter das = ein, ohne Leerzeichen oder
#  Anführungszeichen.
# ══════════════════════════════════════════════════════════════


# ── 1. Discord Bot Authentication ──────────────────────────────
# Bot Token (einmalig vom Discord Developer Portal kopieren)
# Holen: https://discord.com/developers/applications → Bot → Copy
# Der Token hat ~70 Zeichen und sieht aus wie: MTk4NjIyNDgzNTgxODI4ODA.ABCDEF...
DISCORD_BOT_TOKEN=

# Application ID (für OAuth2 Invite-Link)
# Holen: https://discord.com/developers/applications → General Information → Copy
DISCORD_APP_ID=


# ── 2. Channel & Server Setup ──────────────────────────────────
# Channel ID, wo der Bot Clip-Genehmigungen postet
# Holen: Discord → Channel rechtsklick → "ID kopieren" (Developer Mode muss an sein)
# Einstellung: User Settings → Advanced → Developer Mode → ON
DISCORD_CHANNEL_ID=

# Deine eigene Discord User ID (für Erwähnungen und Debugging)
# Holen: Discord → Nachrichten → deine Nachricht rechtsklick → "User ID kopieren"
DISCORD_USER_ID=

# Server/Guild ID (für zukünftige erweiterte Features)
# Holen: Discord → Server rechtsklick → "ID kopieren"
DISCORD_GUILD_ID=


# ── 3. Clip-Genehmigungsprozess ────────────────────────────────
# Welche Reaktionen der Bot erkennt
# ✅ = Clip genehmigt → Auto-publish zu Plattformen
# ❌ = Clip abgelehnt → In Archiv verschieben, nicht veröffentlichen
# 🤔 = Keine Entscheidung getroffen → Nachricht in Warteschlange
APPROVE_EMOJI=✅
REJECT_EMOJI=❌
PENDING_EMOJI=🤔

# Timeout in Sekunden: wie lange der Bot auf Reaktionen wartet
# Standard: 86400 = 24 Stunden
APPROVAL_TIMEOUT_SECONDS=86400

# Wer darf Clips genehmigen? (optional)
# Format: komma-separierte Discord User IDs
# Leer = alle können genehmigen
APPROVAL_ALLOWED_USERS=


# ── 4. Publishing-Plattformen ──────────────────────────────────
# Standardplattformen für genehmigten Clips
# Unterstützt: tiktok, instagram, youtube, whop
# Format: komma-separiert, ohne Leerzeichen
PUBLISH_PLATFORMS=tiktok,instagram,youtube

# Whop: Manuelle URL statt Auto-Publish?
# true = Whop-Upload-Link in Discord schreiben, Nutzer lädt manuell
# false = Zu Whop veröffentlichen wenn API-Zugang konfiguriert
WHOP_MANUAL=true


# ── 5. Logging & Debugging ─────────────────────────────────────
# Log-Level: DEBUG, INFO, WARNING, ERROR
DISCORD_LOG_LEVEL=INFO

# Bot-Status Nachricht (angezeigt unter Bot-Namen)
BOT_STATUS_MESSAGE=Reviewing clips... 👀

# Kanal für Fehler-Reports (optional)
# Wenn gesetzt: Bot schreibt Fehler dahin statt nur in die Logs
DISCORD_ERROR_CHANNEL_ID=


# ── 6. ClippyMe Backend Integration ────────────────────────────
# URL des ClippyMe Backends (wo der Bot Publish-Requests schickt)
# Local: http://localhost:8000
# Remote: https://dein-domain.com
CLIPPYME_API_URL=http://localhost:8000

# API-Authentifizierung (falls nötig)
# Optional: Bearer Token oder API Key
CLIPPYME_API_TOKEN=


# ══════════════════════════════════════════════════════════════
#  WEITERE EINSTELLUNGEN (optional, meist nicht nötig)
# ══════════════════════════════════════════════════════════════

# Automatisch auf Clips antworten? (true/false)
AUTO_REACT_ON_MESSAGE=true

# Thread erstellen für jede Clip-Genehmigung?
CREATE_APPROVAL_THREAD=false

# Archiv-Kanal für abgelehnte Clips (optional)
ARCHIVE_CHANNEL_ID=

# Statistik-Kanal (optional, wo der Bot Zahlen postet)
STATS_CHANNEL_ID=

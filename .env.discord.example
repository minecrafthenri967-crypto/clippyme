# ══════════════════════════════════════════════════════════════
#  DISCORD BOT — Gatekeeper für Clip-Genehmigungen
#
#  Kopiere diese Datei zu .env.discord und fülle deine Werte ein.
#  .env.discord wird in .gitignore ignoriert und nicht hochgeladen.
#
#  Trag die Werte direkt hinter das = ein, ohne Leerzeichen oder
#  Anführungszeichen.
# ══════════════════════════════════════════════════════════════


# ── 1. Discord Bot Authentication ──────────────────────────────
# Bot Token (einmalig vom Discord Developer Portal kopieren)
# Holen: https://discord.com/developers/applications → Bot → Copy
# Der Token hat ~70 Zeichen und sieht aus wie: MTk4NjIyNDgzNTgxODI4ODA.ABCDEF...
DISCORD_BOT_TOKEN=

# Application ID — wird vom Bot selbst NICHT gelesen, du brauchst sie
# nur einmal, um den Einladungslink zu bauen:
#   https://discord.com/oauth2/authorize?client_id=DEINE_APP_ID&permissions=274877959168&scope=bot
# Holen: https://discord.com/developers/applications → General Information → Copy
DISCORD_APP_ID=


# ── 2. Channel Setup ───────────────────────────────────────────
# Channel ID, wo der Bot Clip-Genehmigungen postet
# Holen: Discord → Channel rechtsklick → "ID kopieren" (Developer Mode muss an sein)
# Einstellung: User Settings → Advanced → Developer Mode → ON
DISCORD_CHANNEL_ID=


# ── 3. Clip-Genehmigungsprozess ────────────────────────────────
# Welche Reaktionen der Bot erkennt
# ✅ = Clip genehmigt → wird zu den Plattformen veroeffentlicht
# ❌ = Clip abgelehnt → passiert nichts, Clip bleibt liegen
# 📥 = schickt den Clip NOCH EINMAL in voller Qualitaet (das gepostete Preview
#      ist fuer Discords Upload-Limit extra verkleinert/komprimiert — zum
#      Speichern, z.B. per "Video speichern" am Handy, willst du diese Version,
#      nicht das Preview)
APPROVE_EMOJI=✅
REJECT_EMOJI=❌
DOWNLOAD_EMOJI=📥


# ── 4. Publishing-Plattformen ──────────────────────────────────
# Wohin genehmigte Clips gehen. Es werden nur Plattformen benutzt,
# fuer die in ClippyMe (Einstellungen → Zernio) auch ein Konto
# verbunden ist — der Rest wird still uebersprungen.
# Unterstuetzt: tiktok, instagram, youtube
# Format: komma-separiert, ohne Leerzeichen
PUBLISH_PLATFORMS=tiktok,instagram,youtube

# Welches benannte Zernio-Profil dieser Bot benutzt (Einstellungen → Zernio →
# Profilwähler). Leer/"default" = das eine "normale" Zernio-Konto, wie vor
# den Profilen. Fuer eine zweite Kampagne (z.B. eine eigene eBay-Live-Kampagne
# mit eigenem TikTok/Instagram-Konto) legst du in ClippyMe ein zweites Profil
# an (z.B. "ebay_live") und startest einen ZWEITEN Bot-Container mit einer
# eigenen .env.discord (eigener DISCORD_CHANNEL_ID + dieses Feld gesetzt) —
# EIN Bot pro Kampagne, statt ein Bot der zwischen mehreren Konten wechselt.
#
# WICHTIG: dieses Feld entscheidet auch, WELCHE Clips dieser Bot ueberhaupt
# postet. Beim manuellen Einreichen eines Videos (Create-Tab bzw.
# POST /api/process|/api/batch) waehlst du dort dieselbe Kampagne aus (der
# Profil-Waehler erscheint automatisch, sobald mehr als ein Profil existiert)
# — nur Clips mit passender Kampagne landen in diesem Channel. Ohne diese
# Zuordnung wuerde jeder laufende Bot JEDEN Clip posten, und eine Genehmigung
# im falschen Channel wuerde ueber das falsche Zernio-Konto veroeffentlichen.
ZERNIO_PROFILE=default


# ── 5. ClippyMe Backend Integration ────────────────────────────
# WICHTIG: Bei "docker compose --profile discord up" werden
# CLIPPYME_API_URL und CLIPPYME_OUTPUT_DIR AUTOMATISCH gesetzt
# (auf http://backend:8000 bzw. /app/output) — die Werte hier
# gelten dann nicht und muessen nicht angefasst werden.
# Nur relevant, wenn du den Bot ohne Docker startest:
CLIPPYME_API_URL=http://localhost:8000

# Ordner mit den fertigen Clips (ClippyMes output/). Erlaubt es dem
# Bot, das Video direkt nach Discord hochzuladen — dann braucht das
# Backend gar nicht oeffentlich erreichbar zu sein.
CLIPPYME_OUTPUT_DIR=output

# Oeffentliche Adresse derselben ClippyMe-Instanz, z.B.
# https://clips.deinedomain.de — NUR fuer klickbare Links bei Clips,
# die zu gross fuer Discords Upload-Limit sind. Leer lassen, wenn das
# Backend nicht von aussen erreichbar ist. Ein localhost-Link wird
# NIE gepostet (er zeigt auf den Rechner des Betrachters, nie auf den Server).
# Wird nur benutzt, wenn Backblaze B2 (siehe unten) NICHT eingerichtet ist —
# B2 ist der bevorzugte Weg, weil dafuer das Backend nicht oeffentlich
# erreichbar sein muss (kein Reverse-Proxy/Domain noetig).
CLIPPYME_PUBLIC_URL=

# Backblaze B2 fuer zu grosse Clips: laedt einen Clip, der Discords
# Upload-Limit sprengt, stattdessen zu B2 hoch und postet einen Link statt
# der Fehlermeldung "Datei zu gross". Braucht KEINEN oeffentlich erreichbaren
# Server (im Gegensatz zu CLIPPYME_PUBLIC_URL oben) und keine Groessengrenze
# pro Datei. Der kostenlose Tarif (10 GB) braucht KEINE Kreditkarte.
#
# Einmalige Einrichtung (dauert ~5 Minuten, alles im Backblaze-Dashboard,
# kein SSH/Server-Zugriff noetig):
#   1. https://www.backblaze.com/sign-up/cloud-storage oeffnen, kostenloses
#      Konto anlegen (keine Zahlungsdaten noetig fuer den Gratis-Tarif).
#   2. Im Dashboard "Buckets" → "Create a Bucket" → einen Namen vergeben
#      (z.B. "clippyme-clips") → bei "Files in Bucket are" die Option
#      "Public" waehlen → erstellen.
#   3. Auf den neuen Bucket klicken — dort steht ein "Endpoint" der Form
#      "s3.us-west-004.backblazeb2.com" (die Region-Nummer variiert). Das
#      ist B2_ENDPOINT unten (ohne "https://" davor).
#   4. Links im Menue "Application Keys" → "Add a New Application Key" →
#      auf den eben erstellten Bucket beschraenken, Zugriff "Read and
#      Write" → erstellen.
#   5. Die jetzt angezeigten Werte kopieren (applicationKey wird nur EINMAL
#      angezeigt!): keyID = B2_ACCESS_KEY_ID, applicationKey =
#      B2_SECRET_ACCESS_KEY unten.
#
# Alle vier Felder muessen gesetzt sein, sonst bleibt B2 deaktiviert und
# CLIPPYME_PUBLIC_URL (falls gesetzt) wird stattdessen benutzt.
B2_ENDPOINT=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET_NAME=

# Discords Upload-Limit deines Servers in MB:
# ohne Boost 10, Boost-Stufe 2 = 50, Stufe 3 = 100
MAX_UPLOAD_MB=10

# Optional, aber empfohlen: sperrt das Veroeffentlichen so, dass NUR dieser
# Bot es darf — das ClippyMe-Dashboard und ein laufender Live Monitor koennen
# dann nicht mehr direkt/automatisch veroeffentlichen, nur noch nach deiner
# ✅-Reaktion hier. Muss EXAKT mit PUBLISH_GATE_TOKEN im Backend uebereinstimmen
# (gleiche .env dort, oder als Umgebungsvariable beim Start gesetzt). Ein
# langer Zufallswert reicht, z.B. mit: openssl rand -hex 32
# Leer lassen = Sperre bleibt aus, Veroeffentlichen bleibt wie bisher moeglich.
PUBLISH_GATE_TOKEN=


# ── 6. Was beim Veroeffentlichen eingebrannt wird ──────────────
# ClippyMe rendert Clips zunaechst ROH — Untertitel und Hook werden
# erst beim Publish eingebrannt. Ohne diese Schalter landet ein
# nackter Clip ohne Untertitel auf TikTok & Co.
BURN_SUBTITLES=true
BURN_HOOK=true
BURN_SMARTCUT=false

# Untertitel-Aussehen (nur relevant wenn BURN_SUBTITLES=true)
SUBTITLE_PRESET=hormozi_bold
SUBTITLE_POSITION=bottom
SUBTITLE_FONT=Montserrat-Black

# Wo der Text-Hook sitzt (nur relevant wenn BURN_HOOK=true)
HOOK_POSITION=top

# Zeitzone fuer die Veroeffentlichungsplanung
PUBLISH_TIMEZONE=Europe/Rome

# Wie oft der Bot nach neuen Clips schaut (Sekunden, min. 15)
POLL_SECONDS=60

# Die Discord-Vorschau (Untertitel+Hook eingebrannt, gleiche Optik wie die
# echte Veroeffentlichung) wird NUR fuer den Chat auf diese Hoehe und
# Kompressionsstufe verkleinert — die echte Veroeffentlichung auf
# TikTok/YouTube bleibt davon unberuehrt, immer volle Qualitaet.
# Hoehere Downloadqualitaet (2K/4K) fuehrt sonst zu Dateien ueber Discords
# Upload-Limit. CRF hoeher = kleinere Datei, sichtbar schlechtere Qualitaet.
DISCORD_PREVIEW_MAX_HEIGHT=960
DISCORD_PREVIEW_CRF=30


# ══════════════════════════════════════════════════════════════
#  WEITERE EINSTELLUNGEN (optional, meist nicht nötig)
# ══════════════════════════════════════════════════════════════

# Statistik-Kanal (optional, wo der Bot Zahlen postet)
STATS_CHANNEL_ID=
